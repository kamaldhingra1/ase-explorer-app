flowchart LR
    %% --- CLASS DEFINITIONS FOR PALETTE ALIGNMENT ---
    classDef client fill:#E0F2FE,stroke:#0284C7,stroke-width:2px,color:#0369A1,font-weight:bold;
    classDef orchestrator fill:#EDE9FE,stroke:#7C3AED,stroke-width:3px,color:#5B21B6,font-weight:bold;
    classDef database fill:#ECFDF5,stroke:#10B981,stroke-width:2px,color:#065F46;
    classDef threat fill:#FEE2E2,stroke:#EF4444,stroke-width:2px,color:#991B1B,font-weight:bold;
    classDef blastRadius fill:#FFFDE7,stroke:#EAB308,stroke-width:2px,color:#854D0E;
    classDef external fill:#F1F5F9,stroke:#64748B,stroke-width:2px,color:#334155;

    %% --- NODES & COMPONENTS ---
    User["💻 User"]
    Agent["🧠 Agent Core"]
    STM["💾 Short-Term Memory"]
    LTM["💾 Long-Term Memory"]
    External["🌐 External Content"]
    Poison["💥 Poisoned Data"]
    Future["⚠️ Future Sessions"]

    %% --- APPLY CLASSES ---
    class User client;
    class Agent orchestrator;
    class STM,LTM database;
    class External external;
    class Poison threat;
    class Future blastRadius;

    %% --- FLOW RELATIONSHIPS ---
    %% Standard Execution Loop
    User --> Agent
    Agent --> STM
    STM --> LTM
    LTM --> Agent

    %% Ingestion Paths
    External --> LTM
    Poison --> LTM

    %% Exploitation Blast Radius
    LTM --> Future
