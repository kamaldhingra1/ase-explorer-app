graph TD
    %% Class Definitions for Coloring
    classDef untrusted fill:#FFF2CC,stroke:#D6B656,stroke-width:1px,color:#000;
    classDef edge fill:#FFF2CC,stroke:#D6B656,stroke-width:1px,color:#000;
    classDef external fill:#FFF2CC,stroke:#D6B656,stroke-width:1px,color:#000;
    classDef component fill:#E1D5E7,stroke:#9673A6,stroke-width:1px,color:#000;
    
    %% Security & Isolation Color Classes (Vibrant Alerts)
    classDef criticalAction fill:#F8CECC,stroke:#B85450,stroke-width:2px,color:#000; %% Soft vibrant Red
    classDef activeDefense fill:#FFE6CC,stroke:#D79B00,stroke-width:2px,color:#000;  %% Vibrant Orange/Gold
    classDef isolation fill:#D5E8D4,stroke:#82B366,stroke-width:2px,color:#000;      %% Secure Green

    %% --- UNTRUSTED ZONE ---
    subgraph UNTRUSTED ["UNTRUSTED"]
        User["User"]
    end
    class User untrusted;

    %% --- EXTERNAL ZONE ---
    subgraph EXTERNAL ["EXTERNAL"]
        ExtSystems["External Systems"]
    end
    class ExtSystems external;

    %% --- EDGE ZONE ---
    subgraph EDGE ["EDGE"]
        APIGateway["API Gateway"]
        KillSwitch["🚨 Kill Switch"]
        ToolSandbox["📦 Tool Sandbox"]
        HITL["HITL Checkpoint"]
    end
    class APIGateway,HITL edge;
    class KillSwitch criticalAction;
    class ToolSandbox isolation;

    %% --- INTERNAL ZONE ---
    subgraph INTERNAL ["INTERNAL"]
        GoalManager["Goal Manager"]
        AgentCore["Autonomous Agent Core"]
        PlanningEngine["Planning Engine"]
        LLMCore["LLM Core"]
        SelfReflection["Self-Reflection Module"]
        ToolRegistry["Tool Registry"]
        ShortMemory["Memory (Short-term)"]
        LongMemory["Memory (Long-term)"]
        SafetyGuardrails["🛡️ Safety Guardrails"]
        BoundaryDetection["🚧 Boundary Detection"]
        BehaviorMonitor["Behavior Monitor"]
    end
    class GoalManager,AgentCore,PlanningEngine,LLMCore,SelfReflection,ToolRegistry,ShortMemory,LongMemory,BehaviorMonitor component;
    class SafetyGuardrails,BoundaryDetection activeDefense;

    %% --- RELATIONSHIPS & FLOWS ---
    User --> APIGateway
    APIGateway --> KillSwitch
    KillSwitch --> GoalManager

    GoalManager --> AgentCore
    AgentCore <--> PlanningEngine
    PlanningEngine --> LLMCore
    AgentCore --> SelfReflection
    SelfReflection -- "insight" --> AgentCore
    AgentCore <--> ToolRegistry
    AgentCore <--> ShortMemory
    AgentCore <--> LongMemory
    AgentCore --> SafetyGuardrails
    AgentCore <--> BoundaryDetection

    AgentCore --> ToolSandbox
    ToolSandbox -- "observation" --> ExtSystems
    ExtSystems --> ToolSandbox
    ToolSandbox -- "result" --> AgentCore

    BehaviorMonitor -- "anomaly alert" --> HITL
    AgentCore --> HITL
    HITL --> KillSwitch

    %% Styling Subgraphs
    style UNTRUSTED fill:#FFFDF0,stroke:#D6B656,stroke-width:1px;
    style EDGE fill:#FFFDF0,stroke:#D6B656,stroke-width:1px;
    style EXTERNAL fill:#FFFDF0,stroke:#D6B656,stroke-width:1px;
    style INTERNAL fill:#FFFDF0,stroke:#D6B656,stroke-width:1px;
